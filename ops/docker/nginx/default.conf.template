map $http_x_forwarded_proto $forwarded_scheme {
  default $http_x_forwarded_proto;
  "" $scheme;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Encabezados de seguridad básicos
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options SAMEORIGIN always;

  # Proxy hacia FastAPI: conserva /api/... del backend
  # El frontend no recibe credenciales de las fuentes ni consulta el grafo directamente.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_scheme;
    proxy_read_timeout 120s;
  }

  location = /api/health {
    proxy_pass ${API_UPSTREAM}/health;
    proxy_read_timeout 15s;
  }

  location = /healthz { access_log off; return 200 "ok\n"; }

  # Configuración de ejecución y entrada: sin caché
  location = /config.js { add_header Cache-Control "no-store"; try_files $uri =404; }
  location = /index.html { add_header Cache-Control "no-store"; }

  # Recursos con hash: caché larga
  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }

  location / { try_files $uri $uri/ /index.html; }
}
