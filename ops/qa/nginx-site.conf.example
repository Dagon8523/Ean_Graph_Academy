# Integrar únicamente en el Nginx central de QA tras definir dominio y certificado.
# No reemplazar nginx.conf ni configuraciones de las otras aplicaciones.
server {
    listen 443 ssl;
    server_name DOMINIO_QA_PENDIENTE;
    ssl_certificate RUTA_CERTIFICADO_PENDIENTE;
    ssl_certificate_key RUTA_CLAVE_PENDIENTE;
    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }
}
